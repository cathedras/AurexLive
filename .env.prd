NODE_ENV=production
PORT=3000
ENV_NAME=prd

# ffmpeg: leave empty if ffmpeg is in PATH, otherwise set full path to the binary
# Windows example: FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# macOS/Linux example: FFMPEG_PATH=/usr/bin/ffmpeg
# FFMPEG_PATH=

# Example public CA + internal domain deployment
# USE_HTTPS=1
# SSL_KEY_PATH=/etc/ssl/private/aurexlive.key
# SSL_CERT_PATH=/etc/ssl/certs/aurexlive.crt
# PUBLIC_BASE_URL=https://intra.example.com
# MOBILE_BASE_URL=https://intra.example.com
USE_HTTPS=1
SSL_KEY_PATH=certs/backend-dev.key
SSL_CERT_PATH=certs/backend-dev.crt
# mpv: leave empty to auto-detect from PATH, or set full path to the binary
# macOS (Homebrew): MPV_PATH=/opt/homebrew/bin/mpv
# Windows: MPV_PATH=D:\mpv\mpv.exe
# MPV_PATH=