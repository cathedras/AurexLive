NODE_ENV=development
PORT=3000
FFMPEG_PATH=ffmpeg
ENV_NAME=dev
RECORDING_VOLUME_DEBUG=0
RECORDING_OUTPUT_DEBUG=0
RECORDING_LIVE_DEBUG=1
SWAGGER_AUTO_EXPOSE=1
FRONTEND_DEV_SERVER_URL=https://localhost:5173
USE_HTTPS=0
SSL_KEY_PATH=certs/backend-dev.key
SSL_CERT_PATH=certs/backend-dev.crt
# mpv: leave empty to auto-detect from PATH, or set full path to the binary
# macOS (Homebrew): MPV_PATH=/opt/homebrew/bin/mpv
# Windows: MPV_PATH=D:\mpv\mpv.exe
# MPV_PATH=